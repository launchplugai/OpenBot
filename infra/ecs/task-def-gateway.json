{
  "_comment": "ECS Task Definition for OpenClaw Gateway. Replace ACCOUNT_ID, REGION, EFS_ID, and secret ARNs before registering.",
  "family": "openclaw-gateway",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/openclawTaskRole",
  "volumes": [
    {
      "name": "openclaw-efs",
      "efsVolumeConfiguration": {
        "fileSystemId": "EFS_FILE_SYSTEM_ID",
        "rootDirectory": "/",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "EFS_ACCESS_POINT_ID",
          "iam": "ENABLED"
        }
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "openclaw-gateway",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/openclaw-gateway:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 18789,
          "hostPort": 18789,
          "protocol": "tcp"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "openclaw-efs",
          "containerPath": "/root/.openclaw",
          "readOnly": false
        }
      ],
      "secrets": [
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:openclaw/anthropic-api-key"
        },
        {
          "name": "MOONSHOT_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:openclaw/moonshot-api-key"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:openclaw/openai-api-key"
        },
        {
          "name": "TELEGRAM_BOT_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:openclaw/telegram-bot-token"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/openclaw-gateway",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "gateway"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -sf http://localhost:18789/ || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 90
      },
      "linuxParameters": {
        "initProcessEnabled": true
      }
    }
  ]
}
